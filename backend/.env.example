# =====================================================================
#  Telegram Store Bot - Environment Configuration
#  Copy this file to `.env` and fill in the values.
# =====================================================================

# ---------- General ----------
APP_NAME="Telegram Store"
APP_ENV=development                 # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
DEFAULT_LANGUAGE=id                 # id | en
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Database ----------
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://store:store@postgres:5432/tgstore
# Local dev (SQLite fallback):
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
DB_ECHO=false

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# ---------- Telegram bot ----------
BOT_TOKEN=123456789:AA-your-bot-token
BOT_USERNAME=your_store_bot
BOT_WEBHOOK_URL=                    # empty => long polling
BOT_WEBHOOK_SECRET=
SUPPORT_USERNAME=@your_support
STORE_CHANNEL=@your_channel

# ---------- Telegram Login Widget (admin auth) ----------
# Bot token is used to verify the login hash; ADMIN_TELEGRAM_IDS are auto-seeded.
ADMIN_TELEGRAM_IDS=123456789
DEV_LOGIN_ENABLED=true              # enables password-less dev login for local testing
DEV_LOGIN_TELEGRAM_ID=123456789

# ---------- Payment gateway ----------
PAYMENT_PROVIDER=cryptomus         # cryptomus | mock
CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_API_KEY=
CRYPTOMUS_API_URL=https://api.cryptomus.com/v1
CRYPTOMUS_NETWORK=bep20
PAYMENT_CURRENCY=USDT
INVOICE_LIFETIME_MINUTES=30
PAYMENT_MIN_CONFIRMATIONS=1
WEBHOOK_BASE_URL=http://localhost:8000
DASHBOARD_BASE_URL=http://localhost:3000

# ---------- Store behaviour ----------
ORDER_EXPIRY_MINUTES=30
AUTO_DELIVERY_ENABLED=true
STOCK_LOW_THRESHOLD=5

# ---------- Backup ----------
BACKUP_DIR=./data/backups
