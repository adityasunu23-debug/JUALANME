# ============================================================================
# .env.example — Telegram Store Bot
# Copy to repo root as `.env` (used by docker-compose.yml) AND deploy its
# backend-relevant values into backend/.env (see scripts/bootstrap.sh note).
# NEVER commit the real .env to git!
# ============================================================================

# --- Database (postgres container) -----------------------------------------
# Login of the PostgreSQL superuser inside the container
POSTGRES_USER=store
# Password used by BOTH the postgres container and the backend's DATABASE_URL
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# Name of the application database, created on first boot
POSTGRES_DB=store_db

# --- Backend / app -----------------------------------------------------------
# SQLAlchemy async DSN. Compose overrides the host part to `postgres:5432`
# inside the network; this value is what the backend reads in non-compose runs.
DATABASE_URL=postgresql+asyncpg://store:CHANGE_ME_strong_db_password@postgres:5432/store_db

# Cache / rate-limits / bot offsets queue
REDIS_URL=redis://redis:6379/0

# production | development | staging
APP_ENV=production

# SECRET: signs sessions/JWTs. Generate:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_0f1e2d3c4b5a69788796a5b4c3d2e1f0a9b8c7d6e5f4a3b2

# --- Telegram bot ------------------------------------------------------------
# Token from @BotFather (keep secret!)
BOT_TOKEN=1234567890:AAE_CHANGE_ME_from_BotFather
# Bot's username without @, used in links (e.g. t.me/store_bot)
BOT_USERNAME=store_bot
# Comma-separated Telegram IDs of admins (e.g. OWNER role users)
ADMIN_TELEGRAM_IDS=111111111,222222222

# --- Payments (Cryptomus) ----------------------------------------------------
# Fixed for this project; smells: cryptomus | mock (dev only)
PAYMENT_PROVIDER=cryptomus
# From Cryptomus Dashboard -> Merchants (a UUID)
CRYPTOMUS_MERCHANT_UUID=CHANGE_ME_merchant_uuid
# From Cryptomus Dashboard -> API (DO NOT rotate carelessly, webhooks break)
CRYPTOMUS_API_KEY=CHANGE_ME_cryptomus_api_key
# USDT network: bep20 (Binance Smart Chain). Minimal fees. Verify in your
# Cryptomus dashboard that BEP20 is available for USDT BEFORE going live.
CRYPTOMUS_NETWORK=bep20
# Invoice/settlement currency
PAYMENT_CURRENCY=USDT

# --- Networking / CORS -------------------------------------------------------
# PUBLIC https URL of the deployment. Cryptomus will POST webhooks to:
#   ${WEBHOOK_BASE_URL}/api/v1/payments/webhook/cryptomus
WEBHOOK_BASE_URL=https://your-domain
# Frontend origin allowed to call the backend. Must be your real https domain.
CORS_ORIGINS=https://your-domain

# --- Auth --------------------------------------------------------------------
# DEV login fallback (enter any Telegram ID without wallet signature/login
# widget validation). MUST stay `false` in production!
DEV_LOGIN_ENABLED=false

# --- Optional: image registry for scripts/rollback.sh ------------------------
# REGISTRY=registry.example.com/store
# IMAGE_BACKEND=backend
# IMAGE_DASHBOARD=dashboard
